# AI Prompt Improver Configuration

# Google OAuth (Required)
GOOGLE_CLIENT_ID=your_google_client_id

# AI Providers API Keys
OPENAI_API_KEY=your_openai_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
HUGGINGFACE_API_KEY=your_huggingface_api_key
POE_TOKEN=your_poe_token

# Database Configuration (Optional - uses built-in storage by default)
DATABASE_URL=your_database_url

# Image Analysis Provider (Optional - defaults to mock)
IMAGE_ANALYSIS_PROVIDER=openai

# Google Ads (Optional - for monetization)
GOOGLE_ADS_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxxx

# Development Settings
NODE_ENV=production
VITE_API_BASE_URL=https://api.yourapp.com

# Security Settings
JWT_SECRET=your_jwt_secret
ENCRYPTION_KEY=your_encryption_key

# Payment Processing (For Pro subscriptions)
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx