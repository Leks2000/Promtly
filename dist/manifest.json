{
  "manifest_version": 3,
  "name": "AI Prompt Improver",
  "version": "1.0.0",
  "description": "Modern Chrome Extension for improving AI prompts with clean, intuitive UI",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "AI Prompt Improver"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}